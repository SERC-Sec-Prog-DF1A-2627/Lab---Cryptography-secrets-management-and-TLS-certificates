{
  "name": "College Secure Notes | Python 3.14",
  "image": "mcr.microsoft.com/devcontainers/python:3.14-trixie",
  "postCreateCommand": "python3.14 -m venv .venv && .venv/bin/python -m pip install -r requirements.txt",
  "forwardPorts": [5000],
  "portsAttributes": {
    "5000": {"label": "College Secure Notes", "onAutoForward": "notify"},
    "4443": {"label": "Local TLS exercise", "onAutoForward": "ignore"}
  },
  "customizations": {
    "vscode": {"settings": {"python.defaultInterpreterPath": "${workspaceFolder}/.venv/bin/python"}}
  }
}
